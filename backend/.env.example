# Copy to .env and adjust. All variables are optional; sensible defaults apply.

# Database (defaults to <project_root>/data/jobpilot.db)
# JOBPILOT_DATABASE_URL=sqlite+aiosqlite:////absolute/path/to/jobpilot.db

# Ollama (Milestone 6+)
JOBPILOT_OLLAMA_BASE_URL=http://localhost:11434
JOBPILOT_OLLAMA_MODEL=qwen3:8b

# Logging
JOBPILOT_LOG_LEVEL=INFO
